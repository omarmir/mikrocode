{
  "name": "@t3tools/monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "oxlint-plugin-t3code",
      "packages/*",
      "scripts"
    ],
    "catalog": {
      "effect": "4.0.0-beta.59",
      "@effect/atom-react": "4.0.0-beta.59",
      "@effect/openapi-generator": "4.0.0-beta.59",
      "@effect/platform-bun": "4.0.0-beta.59",
      "@effect/platform-node": "4.0.0-beta.59",
      "@effect/platform-node-shared": "4.0.0-beta.59",
      "@effect/sql-sqlite-bun": "4.0.0-beta.59",
      "@effect/vitest": "4.0.0-beta.59",
      "@effect/language-service": "0.84.2",
      "@pierre/diffs": "1.1.20",
      "@types/bun": "^1.3.11",
      "@types/react": "~19.1.10",
      "@types/node": "^24.10.13",
      "tsdown": "^0.20.3",
      "typescript": "^5.7.3",
      "vitest": "^4.0.0"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "effect-language-service patch",
    "dev": "node scripts/dev-runner.ts dev",
    "dev:server": "node scripts/dev-runner.ts dev:server",
    "dev:marketing": "turbo run dev --filter=@t3tools/marketing",
    "start": "turbo run start --filter=t3",
    "start:marketing": "turbo run preview --filter=@t3tools/marketing",
    "start:mock-update-server": "node scripts/mock-update-server.ts",
    "build": "turbo run build",
    "build:marketing": "turbo run build --filter=@t3tools/marketing",
    "build:mobile:apk": "bash scripts/build-mobile-apk.sh",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --report-unused-disable-directives",
    "test": "turbo run test",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "build:contracts": "turbo run build --filter=@t3tools/contracts",
    "release:smoke": "node scripts/release-smoke.ts",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist apps/*/dist-electron packages/*/dist .turbo apps/*/.turbo packages/*/.turbo",
    "dev:mobile": "node scripts/dev-runner.ts dev:mobile",
    "start:mobile": "turbo run start --filter=@t3tools/mobile",
    "build:mobile": "turbo run build --filter=@t3tools/mobile"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@oxlint/plugins": "^1.63.0",
    "@types/node": "catalog:",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.63.0",
    "turbo": "^2.3.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "@effect/atom-react": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "vite": "^8.0.0"
  },
  "engines": {
    "bun": "^1.3.11",
    "node": "^24.13.1"
  },
  "packageManager": "bun@1.3.11",
  "msw": {
    "workerDirectory": []
  },
  "patchedDependencies": {
    "effect@4.0.0-beta.59": "patches/effect@4.0.0-beta.59.patch"
  },
  "trustedDependencies": [
    "node-pty"
  ]
}
